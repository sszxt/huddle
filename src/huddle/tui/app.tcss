Screen {
    layout: vertical;
}

#nodes {
    height: auto;
    min-height: 5;
    padding: 1;
}

.node-box {
    border: round $primary;
    padding: 0 1;
    width: 1fr;
    margin-right: 1;
    height: auto;
}

.node-box.unreachable {
    border: round $error;
}

#topology {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#status-row {
    height: auto;
    padding: 1;
}

.panel {
    width: 1fr;
    border: round $primary;
    padding: 0 1;
    height: auto;
}

#launch {
    padding: 0 1;
}

#launch-note {
    color: $text-muted;
}

#log {
    height: 1fr;
    border: round $primary;
}

#confirm-dialog,
#model-dialog {
    align: center middle;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
    width: 50;
    height: auto;
}
